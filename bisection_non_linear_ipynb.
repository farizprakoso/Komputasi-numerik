        "# METODE BISECTION (BAGI DUA)\n",
        "# Nama : Al Fariz Prakoso | NIM : 202511420018\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def f(x):\n",
        "    return x**3 - x - 2\n",
        "\n",
        "x_vals = np.linspace(0, 3, 100)\n",
        "plt.plot(x_vals, f(x_vals), label='f(x) = x^3 - x - 2', color='teal')\n",
        "plt.axhline(0, color='red', linestyle='--')\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def bisection(a, b, tol=1e-4):\n",
        "    if f(a) * f(b) >= 0:\n",
        "        print(\"Interval tidak valid! Nilai f(a)*f(b) harus < 0.\")\n",
        "        return None\n",
        "\n",
        "    iterasi = 1\n",
        "    while (b - a) / 2.0 > tol:\n",
        "        c = (a + b) / 2.0\n",
        "        fc = f(c)\n",
        "        print(f\"Iterasi {iterasi}: a={a:.4f}, b={b:.4f}, c={c:.4f}, f(c)={fc:.4f}\")\n",
        "\n",
        "        if abs(fc) < tol:\n",
        "            break\n",
        "        elif f(a) * fc < 0:\n",
        "            b = c\n",
        "        else:\n",
        "            a = c\n",
        "        iterasi += 1\n",
        "\n",
        "    return (a + b) / 2.0\n",
        "\n",
        "akar = bisection(1.0, 2.0)\n",
        "print(f\"\\nPerkiraan Akar Persamaan = {akar:.5f}\")"
      ],
